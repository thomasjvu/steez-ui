{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@steez-ui/icons": [
        "./packages/icons/src/index.ts"
      ],
      "@steez-ui/icons/*": [
        "./packages/icons/src/*"
      ],
      "@steez-ui/theme": [
        "./packages/theme/src/index.ts"
      ],
      "@steez-ui/theme/*": [
        "./packages/theme/src/*"
      ],
      "@steez-ui/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@steez-ui/ui/blocks": [
        "./packages/ui/src/blocks.ts"
      ],
      "@steez-ui/ui/hexagon-grid": [
        "./packages/ui/src/components/HexagonGrid.tsx"
      ]
    },
    "types": [
      "vite/client",
      "node"
    ],
    "tsBuildInfoFile": ".cache/typecheck/site.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "packages/theme/src/**/*.ts",
    "packages/icons/src/**/*.ts",
    "packages/icons/src/**/*.tsx",
    "packages/ui/src/**/*.ts",
    "packages/ui/src/**/*.tsx",
    "vite.config.mts",
    "vitest.config.mts",
    "vitest.setup.ts"
  ],
  "exclude": [
    "node_modules",
    "tmp",
    "dist",
    ".site-ssr",
    ".next",
    "out",
    "packages/*/dist",
    "packages/react",
    "public",
    "registry",
    ".cache"
  ]
}
