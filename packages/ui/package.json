{
  "name": "@steez-ui/ui",
  "version": "0.1.21",
  "description": "React primitives authored with CSS modules for Steez UI.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@steez-ui/icons": "workspace:*",
    "@steez-ui/theme": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "import": "./dist/blocks.js"
    },
    "./hexagon-grid": {
      "types": "./dist/components/HexagonGrid.d.ts",
      "import": "./dist/components/HexagonGrid.js"
    },
    "./styles/Buttons.module.css": "./dist/styles/Buttons.module.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p ./tsconfig.json && node ../../scripts/copy-static-assets.mjs ."
  },
  "publishConfig": {
    "access": "public"
  }
}
