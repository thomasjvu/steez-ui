{
  "name": "steez-ui",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Steez UI — design system packages + registry docs",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm build:packages && next build",
    "build:packages": "pnpm --filter @steez-ui/theme build && pnpm --filter @steez-ui/icons build && pnpm --filter @steez-ui/ui build",
    "build:react": "pnpm --dir packages/react build",
    "pack:react": "pnpm --dir packages/react pack:local",
    "publish:react:forgejo": "node packages/react/scripts/publish-forgejo.mjs",
    "publish:packages": "node scripts/publish-packages.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck:packages": "tsc -p packages/theme/tsconfig.json --noEmit && tsc -p packages/icons/tsconfig.json --noEmit && tsc -p packages/ui/tsconfig.typecheck.json --noEmit",
    "typecheck:site": "tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:site",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:registry-smoke": "node scripts/registry-install-smoke.mjs",
    "registry:build": "shadcn build",
    "registry:generate": "node scripts/generate-registry.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@steez-ui/icons": "workspace:*",
    "@steez-ui/theme": "workspace:*",
    "@steez-ui/ui": "workspace:*",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.9",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.5.25",
    "jsdom": "^30.0.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "tailwindcss": "^4.1.11",
    "three": "^0.179.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "clsx": "^2.1.1",
    "shadcn": "^3.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.2",
      "@types/react-dom": "19.1.2",
      "sharp": "0.35.4",
      "postcss": "8.5.28",
      "nanoid": "3.3.18",
      "browserslist": "4.28.9",
      "@babel/core": "7.29.6"
    }
  }
}
