{
  "name": "steez-ui",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Steez UI \u2014 design system packages + registry docs",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:packages && pnpm build:site",
    "build:packages": "pnpm --filter @steez-ui/theme build && pnpm --filter @steez-ui/icons build && pnpm --filter @steez-ui/ui build",
    "typecheck:react": "pnpm --dir packages/react typecheck",
    "build:react": "pnpm --dir packages/react build",
    "pack:react": "pnpm --dir packages/react pack:local",
    "verify:react": "pnpm --dir packages/react verify",
    "publish:react:forgejo": "node packages/react/scripts/publish-forgejo.mjs",
    "publish:packages": "node scripts/publish-packages.mjs",
    "start": "vite preview",
    "lint": "node scripts/run-check.mjs eslint . --cache --cache-strategy content --cache-location .cache/eslint/",
    "typecheck:packages": "node scripts/run-check.mjs tsc -p packages/theme/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/typecheck/theme.tsbuildinfo && node scripts/run-check.mjs tsc -p packages/icons/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/typecheck/icons.tsbuildinfo && node scripts/run-check.mjs tsc -p packages/ui/tsconfig.typecheck.json --noEmit --incremental --tsBuildInfoFile .cache/typecheck/ui.tsbuildinfo",
    "typecheck:site": "node scripts/run-check.mjs tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:site",
    "test": "node scripts/run-check.mjs vitest run",
    "test:watch": "vitest",
    "test:registry-smoke": "node scripts/run-check.mjs node scripts/registry-install-smoke.mjs",
    "test:standalone-smoke": "node scripts/run-check.mjs node scripts/standalone-copy-smoke.mjs",
    "registry:build": "shadcn build",
    "registry:generate": "node scripts/generate-registry.mjs",
    "deploy:pages": "pnpm build && node scripts/deploy-pages.mjs",
    "build:site": "node scripts/run-check.mjs vite build && node scripts/run-check.mjs vite build --ssr src/entry-server.tsx --outDir .site-ssr && node scripts/prerender-site.mjs",
    "test:site-smoke": "node scripts/site-smoke.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "dependencies": {
    "@fontsource/maple-mono": "^5.3.0",
    "@steez-ui/icons": "workspace:*",
    "@steez-ui/theme": "workspace:*",
    "@steez-ui/ui": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.9",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "^6.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.0.0",
    "shadcn": "^3.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.10",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.2",
      "@types/react-dom": "19.1.2",
      "sharp": "0.35.4",
      "postcss": "8.5.28",
      "nanoid": "3.3.18",
      "browserslist": "4.28.9"
    }
  }
}
